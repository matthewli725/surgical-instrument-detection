# ───────────────────────────────────────────────
# TrayGuard .gitignore
# Generated outputs & large artifacts not
# intended for version control.
# ───────────────────────────────────────────────

# ─── Datasets & large data ────────────────────
/mendeley_dataset/
/dataset
/datasets
/data/

# ─── CV / ML experiment outputs ──────────────
/reports/
/demo
/weights/
/mlruns/
/wandb/
/tensorboard/
/runs/
models/
checkpoints/
*.ckpt
*.pt
*.pth
*.h5
*.onnx
*.joblib
*.pkl

# ─── YOLO / RT-DETR model files ──────────────
yolo11n.pt
yolo11s.pt
yolo11m.pt
yolo11l.pt
yolo26n.pt
rtdetr-l.pt
rtdetr-x.pt

# ─── Generated app assets ─────────────────────
/outputs/
/assets/

# ─── Configuration (keep only specific files) ─
/config/instrument_catalogs/*
!/config/instrument_catalogs/fgvc12_major_tray_v1.json
!/config/tray_modules/*.json

# ─── Project scratch / teammates / docs ──────
/purdue/
/teammates/
/instructions/
/tests/
AGENTS.md
EXPERIMENTS.md
TODO_CV_DATA.md

# ─── LaTeX build artifacts (final_paper/) ─────
/final_paper/source/*.aux
/final_paper/source/*.bbl
/final_paper/source/*.blg
/final_paper/source/*.log
/final_paper/source/*.nav
/final_paper/source/*.out
/final_paper/source/*.snm
/final_paper/source/*.toc
/final_paper/source/*.vrb
/final_paper/source/*.synctex.gz
/final_paper/source/auto/

# ─── Python ───────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
*.egg-info/
*.egg
pip-wheel-metadata/

# ─── Virtual environments ─────────────────────
.env
.venv
env/
venv/
ENV/

# ─── Jupyter ──────────────────────────────────
.ipynb_checkpoints

# ─── Logs ─────────────────────────────────────
logs/
*.log

# ─── IDE / editor ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Environment / secrets ────────────────────
.env
.env.*
*.env

# ─── Testing / coverage ───────────────────────
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# ─── Packaging / cache ────────────────────────
.cache/
*.cache
tmp/
temp/

# ─── macOS system files ───────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
